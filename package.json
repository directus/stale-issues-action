{
	"type": "module",
	"packageManager": "pnpm@10.4.1",
	"engines": {
		"node": "22",
		"pnpm": "10"
	},
	"scripts": {
		"build": "pnpm run '/^(bundle|typecheck)$/'",
		"bundle": "tsup",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"test": "vitest --watch=false"
	},
	"devDependencies": {
		"@actions/core": "1.11.1",
		"@actions/github": "6.0.0",
		"@directus/eslint-config": "0.1.0",
		"@directus/tsconfig": "3.0.0",
		"dayjs": "1.11.13",
		"eslint": "9.21.0",
		"tsup": "8.3.6",
		"typescript": "5.7.3",
		"vitest": "3.0.6"
	}
}
