{
	"type": "module",
	"packageManager": "pnpm@9.15.3",
	"engines": {
		"node": "20",
		"pnpm": "9"
	},
	"scripts": {
		"build": "pnpm run '/^(bundle|typecheck)$/'",
		"bundle": "tsup",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"test": "vitest --watch=false"
	},
	"devDependencies": {
		"@actions/core": "1.11.1",
		"@actions/github": "6.0.0",
		"@directus/eslint-config": "link:../eslint-config",
		"@directus/tsconfig": "3.0.0",
		"dayjs": "1.11.13",
		"eslint": "9.18.0",
		"tsup": "8.3.5",
		"typescript": "5.7.3",
		"vitest": "2.1.8"
	}
}
